# ------------------------------------------------------------------
# DocIntel backend configuration
# Copy to backend/.env and fill in values.
# ------------------------------------------------------------------

# Local development database (no Supabase needed):
# DATABASE_URL=sqlite:///./data/docintel.db
# Production (Supabase): use the Session pooler URI and +psycopg driver.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./data/docintel.db

# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=false
DEMO_EMAIL=admin@docintel.local
DEMO_PASSWORD=admin12345

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:3000

# Storage: "local" (default, zero setup) or "supabase"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# Groq (optional). Without a key the deterministic extractor is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=90

# OCR: auto | rapidocr | tesseract | none
OCR_ENGINE=auto
TESSERACT_CMD=

# Embeddings: auto | fastembed | hash
# "auto" uses FastEmbed if installed, otherwise a deterministic hashing fallback.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Limits
MAX_FILE_MB=200
MAX_FILES_PER_UPLOAD=20
MAX_PDF_PAGES=1500

# Quality / review thresholds
AUTO_APPROVE_CONFIDENCE=0.85
AMOUNT_TOLERANCE=0.01
LINE_ITEM_TOLERANCE_PCT=0.005

# Worker
WORKER_POLL_SECONDS=1.0
WORKER_CONCURRENCY=2
JOB_STALE_SECONDS=1800

# Optional: run an in-process worker with the API (single-service demo).
AUTO_WORKER=false
